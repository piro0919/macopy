  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-use-measure": "2.1.7",
    "ress": "6.0.0"
  },
  "description": "A lightweight and fast clipboard history manager for macOS, inspired by Clipy",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@uphold/commitlint-config": "1.1.1",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv-cli": "11.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-css": "0.12.0",
    "eslint-plugin-css-modules": "2.12.0",
    "eslint-plugin-ext": "0.1.0",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-perfectionist": "5.11.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-write-good-comments": "0.2.0",
    "knip": "^6.34.0",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "stylelint": "17.14.1",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-css-modules-no-global-scoped-selector": "1.0.2",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-high-performance-animation": "2.0.0",
    "stylelint-no-unused-selectors": "1.0.40",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "clipboard-history",
    "macos",
    "tauri",
    "react",
    "typescript",
    "menubar",
    "productivity"
  ],
  "license": "MIT",
  "name": "macopy",
  "overrides": {
    "stylelint-css-modules-no-global-scoped-selector": {
      "stylelint": "$stylelint"
    },
    "stylelint-no-unused-selectors": {
      "stylelint": "$stylelint"
    }
  },
  "productName": "Macopy",
  "repository": {
    "type": "git",
    "url": "https://github.com/piro0919/macopy.git"
  },
  "scripts": {
    "build": "tauri build && npm run codesign",
    "codesign": "codesign --deep --force --sign - 'src/target/release/bundle/macos/Macopy.app'",
    "dev": "tauri dev",
    "dev:lp": "npm --prefix lp run dev",
    "generate-icon": "bash scripts/generate-icon.sh",
    "lint": "npx eslint",
    "lint:fix": "npx eslint --fix",
    "lint:style": "stylelint --fix '**/*.css'",
    "prettier": "prettier --write .",
    "type-check": "tsc --noEmit",
    "vite:build": "vite build --sourcemap false",
    "vite:dev": "vite"
  },
  "version": "0.4.0"
}
